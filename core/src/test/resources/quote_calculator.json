{
 "schema_version": 1,
 "description": "Synthetic offline exact pricing vectors. Expected values computed independently with fractions.Fraction; no market, network or wallet data.",
 "serialization": "All integers inside cases.expected (including transaction_vbytes) and monetary/satoshi inputs are base-10 strings, even when JS-safe. Null remains null. Python core numeric row contract is unchanged; stringify integer outputs recursively before fixture comparison. Exponents, floats, bools and whitespace are invalid inputs.",
 "contract": {
  "rates": "Raw btc_toman/usdt_toman positive <=1000000000000000; fee_rate positive <=10000; up to18 fractional places; input text <=64 characters.",
  "principal": "int or ASCII digits; 501 <= principal_sats <=2100000000000000.",
  "budget": "Whole toman int or ASCII digits; 0 <= budget_toman <=10^64-1. No table budget cap. Below minimum cost: Python ValueError; browser explicit insufficient status with no principal.",
  "raw_asset_toman": "Exact principal_sats * raw btc_toman /100000000; no exchange markup, network, materials, post, operator or ceiling. Decimal text.",
  "formula": "adjustedBTC=rawBTC*101/100 (one 1% exchange markup, applied to the rate only); adjustedUSDT=rawUSDT (no markup); satprice=adjustedBTC/100000000; network=ceil(rate*141); convert=ceil((2/100)*adjustedUSDT/satprice); transfer=423; materials=ceil((5/100)*adjustedUSDT/satprice); envelope=ceil((6/100)*adjustedUSDT/satprice) unless in_person; post=ceil((75/100)*adjustedUSDT/satprice) unless in_person; tag=ceil((12/100)*adjustedUSDT/satprice) when include_tag; operator=ceil((3/20)*(principal+network+convert+transfer+materials+envelope+post+tag)); totalToman=ceil((principal+network+convert+transfer+materials+envelope+post+tag+operator)*satprice); totalRial=totalToman*10; remainder=budget-totalToman. The principal is never charged a second percentage fee. Budget result is maximal principal bounded by supply.",
  "materials": "Per-envelope materials total $0.05 = $0.03 wax seal + $0.01 paper + $0.01 print, exposed as materials_sats/materials_usd with the breakdown in assumptions (seal_usd, paper_usd, print_usd). The $0.06 envelope is a separate postal cost, not part of materials.",
  "post": "Separate per-envelope postage of $0.75, exposed as post_sats/post_usd; included in the 15% operator subtotal like every other cost.",
  "acquisition": "convert_sats is the flat $0.02 exchange conversion fee converted at the same USDT assumption; transfer_sats is 423 satoshis, fixed in bitcoin and never multiplied by a rate. Both appear in costs and in every row and are inside the 15% operator subtotal. Neither depends on the selected fee speed; only network_sats does."
 },
