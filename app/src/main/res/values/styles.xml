<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">@font/sahel</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorBackground">@color/paper</item>
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/muted</item>
        <item name="android:statusBarColor">@color/paper</item>
        <item name="android:navigationBarColor">@color/paper</item>
        <item name="android:windowLightStatusBar">true</item>
        <!-- Light navigation icons are selected by the Activity on API 26+. -->
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:alertDialogTheme">@style/SiteDialog</item>
    </style>
    <style name="SiteDialog" parent="android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:fontFamily">@font/sahel</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorBackground">@color/surface</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/muted</item>
    </style>
</resources>
